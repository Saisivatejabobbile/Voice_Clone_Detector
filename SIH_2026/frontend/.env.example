# VoiceShield Frontend Environment Variables

# Backend API URL
VITE_API_URL=http://localhost:8000

# WebSocket URL
VITE_WS_URL=ws://localhost:8000

# STUN Server
VITE_STUN_SERVER_URL=stun:stun.l.google.com:19302

# TURN Server (optional)
# VITE_TURN_SERVER_URL=turn:your-turn-server.com:3478
# VITE_TURN_USERNAME=your-username
# VITE_TURN_PASSWORD=your-password

# Mock Mode (for development without backend)
VITE_MOCK_MODE=false

# IMPORTANT SECURITY NOTES:
# - NEVER put MODEL_API_KEY here (it's backend-only)
# - NEVER store audio data in environment variables
# - All VITE_ variables are exposed to the browser
# - Keep sensitive data on the backend only
