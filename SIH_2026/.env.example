# VoiceShield Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://voiceshield_user:your_password@localhost:5432/voiceshield
# Format: postgresql://username:password@host:port/database

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Generate with: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =============================================================================
# EXTERNAL MODEL API CONFIGURATION
# =============================================================================

# IMPORTANT: The AI model is deployed externally and accessed via API
# This application does NOT train or deploy the model

MODEL_MODE=mock
# Options: "mock" (development) or "real" (production with actual model)
# Use "mock" for development and testing without external model dependency

MODEL_API_URL=https://your-model-api.example.com/predict
# The URL of your externally deployed voice detection model API
# Example: https://api.voicedetection.ai/v1/analyze

MODEL_API_KEY=your-model-api-key-here
# CRITICAL: Keep this secret! NEVER expose to frontend!
# NEVER use VITE_ prefix for this variable
# Backend only - used to authenticate with external model API

MODEL_TIMEOUT_SECONDS=10
# Maximum time to wait for model API response

# =============================================================================
# AUDIO PROCESSING CONFIGURATION
# =============================================================================

ANALYSIS_SAMPLE_RATE=16000
# Audio sample rate in Hz (typically 16000 or 8000)
# Must match what the external model expects

ANALYSIS_WINDOW_SECONDS=3
# Duration of audio window sent to model for analysis

ANALYSIS_CHANNELS=1
# Number of audio channels (1 = mono, 2 = stereo)
# Typically use mono (1) for voice analysis

MAX_BUFFER_SIZE=480000
# Maximum audio buffer size in samples (30 seconds at 16kHz)
# Prevents unbounded memory growth

# =============================================================================
# RISK SCORING THRESHOLDS
# =============================================================================

RISK_LOW_THRESHOLD=30
# Risk scores below this are considered LOW (0-30)

RISK_HIGH_THRESHOLD=70
# Risk scores above this are considered HIGH (71-100)
# Scores between LOW and HIGH are MEDIUM (31-70)

# Note: These are application policy thresholds, not scientific absolutes
# Adjust based on your risk tolerance and use case

# =============================================================================
# AUDIO RETENTION POLICY
# =============================================================================

AUDIO_RETENTION=false
# MUST be false - raw audio is never persisted by design
# This is a safety flag to ensure privacy architecture is maintained

# =============================================================================
# WEBRTC CONFIGURATION
# =============================================================================

# STUN Server (for NAT traversal - public Google STUN is fine for development)
STUN_SERVER_URL=stun:stun.l.google.com:19302

# TURN Server (optional but recommended for production)
TURN_SERVER_URL=turn:your-turn-server.example.com:3478
TURN_USERNAME=your-turn-username
TURN_PASSWORD=your-turn-password
# If you don't have a TURN server, you can use services like:
# - Twilio (https://www.twilio.com/stun-turn)
# - Xirsys (https://xirsys.com/)
# - Self-hosted coturn (included in infra/)

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_URL=http://localhost:5173
# Used for CORS configuration

# =============================================================================
# REDIS (OPTIONAL - for presence and call state in production)
# =============================================================================

REDIS_URL=redis://localhost:6379/0
# Leave empty to use in-memory state management
# Format: redis://username:password@host:port/db

REDIS_ENABLED=false
# Set to true to use Redis for presence and active call state

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# IMPORTANT: Audio data must NEVER be logged
# Password, tokens, and API keys must NEVER be logged

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Comma-separated list of allowed origins

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================

WS_MAX_CONNECTIONS_PER_USER=2
# Maximum WebSocket connections per user (signaling + analysis)

WS_HEARTBEAT_INTERVAL=30
# WebSocket ping interval in seconds

WS_MAX_MESSAGE_SIZE=1048576
# Maximum WebSocket message size in bytes (1 MB)

# =============================================================================
# RATE LIMITING (Recommended for production)
# =============================================================================

RATE_LIMIT_ENABLED=false
# Enable rate limiting for API endpoints

RATE_LIMIT_LOGIN=5/minute
# Login attempts per minute

RATE_LIMIT_REGISTER=3/hour
# Registration attempts per hour

# =============================================================================
# DATABASE CONNECTION POOL
# =============================================================================

DB_POOL_SIZE=5
# Number of database connections in pool

DB_MAX_OVERFLOW=10
# Maximum overflow connections

# =============================================================================
# DEVELOPMENT / PRODUCTION
# =============================================================================

ENVIRONMENT=development
# Options: development, staging, production

DEBUG=true
# Set to false in production

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# Sentry (Error Tracking - NEVER log audio!)
# SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id

# Analytics (Aggregate stats only - NO audio, NO PII)
# ANALYTICS_ENABLED=false
# ANALYTICS_API_KEY=your-analytics-key

# =============================================================================
# SECURITY HEADERS (Production)
# =============================================================================

# Content Security Policy
# CSP_HEADER="default-src 'self'; connect-src 'self' ws: wss:;"

# =============================================================================
# IMPORTANT REMINDERS
# =============================================================================

# 1. NEVER commit .env to Git
# 2. NEVER expose MODEL_API_KEY to frontend
# 3. NEVER use VITE_ prefix for MODEL_API_KEY
# 4. NEVER log audio data, passwords, or tokens
# 5. NEVER persist raw call audio
# 6. Change JWT_SECRET in production
# 7. Use strong database passwords
# 8. Enable HTTPS in production
# 9. Review and test privacy guarantees
# 10. Read PRIVACY.md before deployment

# =============================================================================
# VERIFICATION CHECKLIST
# =============================================================================

# Before deploying:
# [ ] Changed all default passwords and secrets
# [ ] Configured external model API credentials
# [ ] Set up TURN server for NAT traversal
# [ ] Reviewed PRIVACY.md and verified no audio persistence
# [ ] Tested complete call flow end-to-end
# [ ] Enabled HTTPS/WSS in production
# [ ] Configured CORS for production domain
# [ ] Set DEBUG=false and ENVIRONMENT=production
# [ ] Verified MODEL_API_KEY is backend-only
# [ ] Tested cleanup on call termination
# [ ] Reviewed logs (no sensitive data)
