*.ipynb

# =============================================================================
# CERTIFICATES / KEYS
# =============================================================================

# SSL/TLS certificates
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx

# SSH keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# =============================================================================
# BACKUP FILES
# =============================================================================

*.bak
*.backup
*.old
*.orig

# =============================================================================
# PROFILING / MONITORING
# =============================================================================

.profile
*.prof
*.trace

# =============================================================================
# PROJECT-SPECIFIC
# =============================================================================

# Local development overrides
docker-compose.local.yml
.env.local

# Documentation builds
docs/_build/
docs/.doctrees/

# Test output
test-results/
test-reports/

# =============================================================================
# CACHE DIRECTORIES
# =============================================================================

.cache/
.parcel-cache/
.npm/
.eslintcache
.stylelintcache

# =============================================================================
# DEPLOYMENT
# =============================================================================

# Deployment scripts with secrets
deploy-secrets.sh
production-secrets.yml

# Kubernetes secrets
*-secrets.yaml
*-secrets.yml

# =============================================================================
# IMPORTANT REMINDERS
# =============================================================================

# This .gitignore ensures:
# 1. No secrets or credentials are committed
# 2. No audio files are committed (by design, none should exist)
# 3. No model weights are committed (models are external)
# 4. No sensitive logs are committed
# 5. No database dumps with user data are committed

# Before committing, always verify:
# - No .env files
# - No audio files
# - No secrets in code
# - No MODEL_API_KEY in frontend
# - No passwords or tokens
