# VoiceShield .gitignore

# =============================================================================
# SECRETS AND ENVIRONMENT VARIABLES
# =============================================================================
.env
.env.local
.env.production
.env.*.local
*.env

# NEVER commit:
# - Database credentials
# - JWT secrets
# - MODEL_API_KEY
# - API keys
# - Passwords

# =============================================================================
# AUDIO FILES (Should never exist, but just in case)
# =============================================================================
*.wav
*.mp3
*.mp4
*.webm
*.ogg
*.flac
*.aac
*.m4a
*.wma
*.pcm
*.raw
*.au

# Audio recordings directory (should never be created)
recordings/
audio/
voice/
uploads/audio/

# =============================================================================
# PYTHON / BACKEND
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

